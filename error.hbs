{{!< default}}

<main id="site-main" class="site-main error-main">
    <div class="container">

        <section class="error-hero">
            <p class="error-label">{{statusCode}} · {{message}}</p>
            <h1 class="error-headline">Something went wrong on our side.</h1>
            <p class="error-lead">
                {{#if errorDetails}}{{errorDetails}}{{else}}Please try again in a moment.{{/if}}
                In the meantime you can head back to the
                <a href="{{@site.url}}" title="Trema home">front page</a>
                or browse the <a href="/tag/fiction/" title="Browse all fiction">fiction</a>
                and <a href="/tag/non-fiction/" title="Browse all non-fiction">non-fiction</a> shelves.
            </p>
        </section>

    </div>
</main>
