<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    
    {{! Document Settings }}
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    
    {{! Page Meta }}
    <title>
        {{#post}}
            {{title}}{{#if primary_tag}} by {{primary_tag.name}}{{/if}} · {{@site.title}}
        {{else}}
            {{#page}}
                {{title}} · {{@site.title}}
            {{else}}
                {{#tag}}
                    {{name}} · {{@site.title}}
                {{else}}
                    {{#primary_author}}
                        {{name}} · {{@site.title}}
                    {{else}}
                        {{meta_title}}
                    {{/primary_author}}
                {{/tag}}
            {{/page}}
        {{/post}}
    </title>
    
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{! iOS Safari zooms the page when Ghost's search input is focused. Ghost's own search
        iframe declares maximum-scale=1 for this, but iOS only honours the parent page's
        viewport, so mirror it here. iOS-only: it would disable pinch zoom on Android. }}
    <script>
        if (/iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
            document.querySelector('meta[name="viewport"]').setAttribute('content', 'width=device-width, initial-scale=1, maximum-scale=1');
        }
    </script>
    
    {{! Brand icon }}
    <link rel="shortcut icon" href="{{@site.icon}}" type="image/png" />
    
    {{! Ghost(Pro) redirects every image to storage.ghost.io, so open that connection early }}
    <link rel="preconnect" href="https://storage.ghost.io">

    <link rel="preload" href="{{asset "fonts/DegularVariable.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{asset "fonts/Blanco-Regular.woff"}}" as="font" type="font/woff" crossorigin>

    {{! Styles'n'Scripts }}
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />
    
    {{! Custom meta tags to prioritize Twitter image over Facebook image }}
    {{#post}}
        {{#if twitter_image}}
            <meta property="og:image" content="{{twitter_image}}" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta name="twitter:image" content="{{twitter_image}}" />
        {{else if feature_image}}
            <meta property="og:image" content="{{img_url feature_image size="l"}}" />
            <meta name="twitter:image" content="{{img_url feature_image size="l"}}" />
        {{/if}}
    {{/post}}
    
    {{! Ghost outputs structured data with JSON-LD }}
    {{ghost_head}}


</head>
<body class="{{body_class}}">
<div class="viewport">
<div class="container">
    {{!-- Ghost only loads partials/ when a template includes one with {{> }}; this also enables the navigation.hbs override --}}
    {{> "site-header"}}
</div>

    <main class="site-content">
        {{! Everything else gets inserted here, index.hbs, post.hbs, etc }}
        {{{body}}}
    </main>


</div>

    <footer class="site-footer outer">
        <div class="footer-content">
            <nav class="site-footer-nav">
                {{navigation type="secondary"}}
            </nav>
            <div class="gh-powered-by">
                Published with <a href="https://ghost.org/" target="_blank" rel="noopener" title="Ghost: publishing software">Ghost</a>
            </div>
        </div>
    </footer>

{{! Ghost outputs important scripts and data with this tag }}
{{ghost_foot}}

{{! Override Ghost card_assets bookmark styles for dark mode. Ghost's card CSS loads after
    screen.css, so these need the extra weight; the colours come from screen.css variables so
    shelf-tinted article pages can swap them. }}
<style>
@media (prefers-color-scheme: dark) {
    figure.kg-bookmark-card {
        background: transparent !important;
    }
    a.kg-bookmark-container {
        background: var(--color-bookmark-bg) !important;
        border-color: var(--color-bookmark-border) !important;
    }
    a.kg-bookmark-container:hover {
        background: var(--color-bookmark-hover-bg) !important;
        border-color: var(--color-bookmark-hover-border) !important;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3) !important;
    }
    .kg-bookmark-content {
        background: transparent !important;
    }
    .kg-bookmark-card:not(.kg-bookmark-fiction):not(.kg-bookmark-nonfiction) .kg-bookmark-thumbnail {
        background: var(--color-bookmark-thumb-bg) !important;
    }
    .kg-bookmark-title {
        color: var(--color-text) !important;
    }
    .kg-bookmark-description {
        color: var(--color-text-light) !important;
    }
    .kg-bookmark-metadata {
        color: var(--color-text-light) !important;
    }
}
</style>

<script src="{{asset "js/main.js"}}"></script>

</body>
</html>
